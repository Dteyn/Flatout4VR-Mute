#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @VI_FILE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Dteyn\0"
            VALUE "FileDescription", "@VI_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "@VI_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Dteyn\0"
            VALUE "OriginalFilename", "@VI_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "FlatOut 4 VR Mute\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "Author", "Dteyn\0"
            VALUE "ProjectURL", "https://github.com/Dteyn/Flatout4VR-Mute\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
